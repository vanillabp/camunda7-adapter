<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The VanillaBP release parent, like every repository of the vanillabp organisation. It
       brings the plugins and the two profiles a release to Maven Central needs: sources,
       javadoc, the GPG signature and the central-publishing plugin. It also names the
       snapshot repository of Maven Central, which spi-for-java and the platform publish to,
       and which this adapter publishes its own snapshots to. 'relativePath' is empty because
       there is no POM beside this one to find it in; without that, Maven looks at
       '../pom.xml' first. -->
  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>2.0.0</version>
    <relativePath/>
  </parent>

  <groupId>io.vanillabp</groupId>
  <artifactId>camunda7-adapter-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>VanillaBP Camunda 7 adapter</name>
  <description>VanillaBP Version 2 adapter for Camunda 7 (embedded engine).</description>
  <!-- Our own address, because the parent has one and a child inherits it with its own name
       appended. The four 'inherit.append.path' attributes turn the appending off, one on
       <project> above for the URL and three on <scm> below. -->
  <url>https://github.com/vanillabp/camunda7-adapter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <modules>
    <module>core</module>
    <module>spring-boot</module>
    <module>spring-boot-webapps</module>
    <module>quarkus/runtime</module>
    <module>quarkus/deployment</module>
    <module>quarkus/integration-tests</module>
    <module>integration-tests</module>
    <module>test-coverage-report</module>
  </modules>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/vanillabp/camunda7-adapter.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp/camunda7-adapter.git</developerConnection>
    <url>https://github.com/vanillabp/camunda7-adapter/tree/main</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- A module which is not published sets this to true in its own properties. The
         snapshots and the release go out through central-publishing-maven-plugin of the
         profile 'central-portal', which does not read it, so such a module also names itself
         in 'central.publishing.excluded', see the plugin below. -->
    <maven.deploy.skip>false</maven.deploy.skip>
    <central.publishing.excluded>none</central.publishing.excluded>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <version.java>21</version.java>
    <jacoco.version>0.8.16</jacoco.version>
    <!-- where the build breaks, in PERCENT of covered instructions per platform,
         enforced by test-coverage-report/coverage-gate. The rule stays 90 per platform, which is
         the number the coverage badges of the README are read against. The gate stands at
         85, the same number in every VanillaBP repository, because a threshold marks the
         point where somebody has to look and not the goal to aim at. It is never raised to whatever a
         suite happens to reach, and never lowered to make a build pass. -->
    <coverage.threshold.spring-boot>85</coverage.threshold.spring-boot>
    <coverage.threshold.quarkus>85</coverage.threshold.quarkus>
    <!-- the rule, as a number the gate can print: it reports every run against both, so
         the distance between a passing build and the rule is readable without opening
         the report -->
    <coverage.rule>90</coverage.rule>
    <spi-for-java.version>2.0.0-SNAPSHOT</spi-for-java.version>
    <adapter-platform.version>2.0.0-SNAPSHOT</adapter-platform.version>
    <camunda.version>7.24.0</camunda.version>
    <spring-boot.version>4.1.2</spring-boot.version>
    <quarkus.version>3.40.1.1</quarkus.version>
    <lombok.version>1.18.48</lombok.version>
    <!-- the engine's StrongUuidGenerator needs it, and camunda-engine declares it 'provided'.
         The version is the one camunda-engine is built against, so it moves only with the engine -->
    <java-uuid-generator.version>4.3.0</java-uuid-generator.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>spi-for-java</artifactId>
        <version>${spi-for-java.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-adapter-spi</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp.adapter</groupId>
        <artifactId>migration-adapter</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-spring-boot-integration</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>vanillabp-quarkus-integration-deployment</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>test-utils</artifactId>
        <version>${adapter-platform.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-engine</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-engine-spring-6</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.uuid</groupId>
        <artifactId>java-uuid-generator</artifactId>
        <version>${java-uuid-generator.version}</version>
      </dependency>
      <!-- Managed here and declared without a version in the three modules which use
           them, so that no POM we publish names '${camunda.version}' where a consumer
           reads a version. Our own build resolved that name because this file is in the
           reactor, while a consumer reads the published child and resolves this file as
           the newest build of the snapshot, never as the build the child went out with.
           The property and the versions using it now stand in one file, so our own build
           is what breaks if the property ever leaves, instead of a consumer breaking
           later. See handAnApplicationNoPropertyInsteadOfAValue in PublishedPoms of the
           platform's test-utils. The entries carry the version and nothing else: a scope
           written here would apply to the transitive paths too, and the test scope these
           three have in two modules belongs at the declaration. -->
      <dependency>
        <groupId>org.camunda.bpm.springboot</groupId>
        <artifactId>camunda-bpm-spring-boot-starter-webapp</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm.springboot</groupId>
        <artifactId>camunda-bpm-spring-boot-starter-external-task-client</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-engine-plugin-spin</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>org.camunda.spin</groupId>
        <artifactId>camunda-spin-dataformat-json-jackson</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <!-- 'provided' here and again at every declaration below: Lombok translates the
           source and has no work left once the class file exists, so no application using
           our artifacts may find it on its runtime classpath. Writing 'optional' here did
           not do that. Maven copies a managed version, scope and exclusions into a
           dependency, but not the optional flag, so the POMs we publish said nothing. -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- The profile 'central-portal' of the parent brings this plugin, and it bundles
               every module of the reactor, because it does not read 'maven.deploy.skip'. A
               version on Central cannot be taken back, so the module set has to be right
               before the first release. A module which is not published sets
               'central.publishing.excluded' to its own artifactId. -->
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <configuration>
            <excludeArtifacts>
              <excludeArtifact>${central.publishing.excluded}</excludeArtifact>
            </excludeArtifacts>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!-- '@{jacoco.agent}' is resolved lazily per module (late property binding),
                 forwarding coverage also into forked JVMs -->
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <argLine>@{jacoco.agent}</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${version.java}</release>
            <compilerArgs>
              <!-- most of this adapter is internal, so most of its javadoc is out of reach
                   of the javadoc plugin of this pom: that one reads what Maven Central
                   shows and starts at protected. javac reads the comment on a private field as well,
                   which is where a link to a renamed method quietly rots. Every group is
                   checked but 'missing', because a comment which was never written is a
                   warning and not a broken build. -->
              <arg>-Xdoclint:all,-missing</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <!-- javadoc runs in every build. A goal nobody runs stops working without
                 anybody noticing, and the release is a bad moment to find that out, because
                 that is when the javadoc artifact is built.
                 It breaks on errors, which is a reference javadoc cannot resolve or broken
                 HTML, and it breaks on warnings too, which is mostly a comment nobody
                 wrote. What this repository publishes is read by somebody wiring this
                 adapter into an application, and by whoever writes the next adapter against
                 the same SPI, so a missing sentence is a gap for a reader with no other
                 source. The gaps here were written once. Letting a warning pass again would
                 park the next one in a build which looks green. -->
            <doclint>all</doclint>
            <failOnError>true</failOnError>
            <failOnWarnings>true</failOnWarnings>
            <!-- the Quarkus extension processor writes an accessor class next to every
                 class carrying build steps, and generated code has no comments. It is
                 compiled, never published and read by nobody, so it is left out here
                 rather than being the reason a warning stays allowed everywhere. -->
            <sourceFileExcludes>
              <sourceFileExclude>**/*$$accessor.java</sourceFileExclude>
            </sourceFileExcludes>
            <!-- no link into the JDK API: that link is fetched over the network, and the
                 check should give the same answer on a machine without one. No link into
                 the javadoc of the other modules either: it is not built at this point,
                 and every module would report the miss -->
            <detectJavaApiLink>false</detectJavaApiLink>
            <detectOfflineLinks>false</detectOfflineLinks>
            <!-- javadoc stops after 100 warnings per module, and the line it prints
                 reads like the end of the list. Whoever counts warnings to see how much
                 work a module still holds counts too few. The number below is high enough
                 that no module reaches it. The parent configures javadoc as well, and every
                 option this gate needs stands here, so the two cannot drift apart unnoticed.
                 The run is incremental too: a module whose sources did not move since the
                 last run is skipped and reports nothing. Delete 'target/reports/apidocs'
                 before counting, or a clean count only says that nobody recompiled. -->
            <additionalOptions>
              <additionalOption>-Xmaxwarns 100000</additionalOption>
            </additionalOptions>
          </configuration>
          <executions>
            <execution>
              <id>check-javadoc</id>
              <goals>
                <!-- no fork: the sources are there by this phase -->
                <goal>javadoc-no-fork</goal>
              </goals>
              <!-- after the tests, so a javadoc error does not hide a test result, and
                   still inside a plain 'mvn install' -->
              <phase>package</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
      <!-- no maven-source-plugin here: a snapshot carries no sources jar. Every file a
           snapshot uploads is one more request to Maven Central, and Central answers too many
           of them with 429. A release still carries a sources jar, because the profile
           'release' of release-parent binds the plugin -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <propertyName>jacoco.agent</propertyName>
          <excludes>
            <exclude>**/it/**</exclude>
            <exclude>**/test/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <yaml>
            <includes>
              <include>**/*.yaml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <jackson>
              <yamlFeatures>
                <MINIMIZE_QUOTES>true</MINIMIZE_QUOTES>
                <WRITE_DOC_START_MARKER>false</WRITE_DOC_START_MARKER>
                <INDENT_ARRAYS_WITH_INDICATOR>true</INDENT_ARRAYS_WITH_INDICATOR>
              </yamlFeatures>
            </jackson>
          </yaml>
          <java>
            <eclipse>
              <!-- https://help.eclipse.org/latest/index.jsp?topic=%2Forg.eclipse.jdt.doc.isv%2Freference%2Fapi%2Forg%2Feclipse%2Fjdt%2Fcore%2Fformatter%2FDefaultCodeFormatterConstants.html -->
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- publishes a snapshot to two places in one build. GitHub Packages is what the builds of
         the other VanillaBP repositories read. The snapshot repository of Maven Central is
         what everybody else reads, because it needs no login. Only a push to main of the
         repository in the vanillabp organization turns this profile on: the workflow asks
         for an Actions variable which a fork does not have.

         The profile 'central-portal' of the parent cannot do this. There the Central plugin
         removes every execution of maven-deploy-plugin, so nothing could reach a second
         repository. The plugin leaves maven-deploy-plugin alone as soon as the POM binds the
         goal 'publish' itself, and that is why the execution below is spelled out. -->
    <profile>
      <id>publish-snapshots</id>
      <distributionManagement>
        <snapshotRepository>
          <!-- the workflow gives this server the GITHUB_TOKEN of the run. GITHUB_REPOSITORY is
               the repository the workflow runs in, so the URL stays right where a fork or a
               copy of this POM publishes, and a POM which another repository takes over
               by sync needs no change -->
          <id>github-packages</id>
          <name>GitHub Packages of ${env.GITHUB_REPOSITORY}</name>
          <url>https://maven.pkg.github.com/${env.GITHUB_REPOSITORY}</url>
        </snapshotRepository>
      </distributionManagement>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <version>3.2.0</version>
            <!-- no 'skip' here: the plugin reads 'maven.deploy.skip', and a module which is
                 not published sets it. So that module stays out of GitHub Packages like it
                 stays out of Maven Central -->
            <configuration>
              <!-- uploads after the last module was built, like the Central plugin does. So a
                   build which fails halfway leaves both repositories as they were -->
              <deployAtEnd>true</deployAtEnd>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <!-- copied from the profile 'central-portal' of release-parent 2.0.0. Compare
                 them with 'mvn help:effective-pom' after the parent moves -->
            <configuration>
              <publishingServerId>vanillabp-central</publishingServerId>
              <!-- where a snapshot goes. Without this URL the plugin takes the snapshot
                   repository of the POM, and this profile sets that to GitHub Packages. So
                   the snapshot went to GitHub Packages twice and never to Maven Central.
                   The profile 'central-portal' needs no URL: there the POM names no
                   snapshot repository, and the plugin falls back to this one -->
              <centralSnapshotsUrl>https://central.sonatype.com/repository/maven-snapshots/</centralSnapshotsUrl>
              <!-- leaves a module out of Maven Central. The upload of all other modules
                   still runs at the end, also where the last module of the build is one
                   which is left out -->
              <skipPublishing>${skip.central.release}</skipPublishing>
              <checksums>required</checksums>
              <skipUpload>${central.skip.upload}</skipUpload>
            </configuration>
            <executions>
              <execution>
                <id>publish-to-central</id>
                <goals>
                  <goal>publish</goal>
                </goals>
                <phase>deploy</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
