<?xml version="1.0" encoding="UTF-8"?>
<!-- Story 57, version 1 of the process: a task which survives into version 2, a task
     which is dropped there, and a task nobody serves in this version (its method names
     a version this engine does not hold). The dropped task stays open, so a workflow
     started here is still running on version 1 when the next boot deploys version 2 -
     and it never reaches the unserved task, which would raise an incident instead. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Story57V1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Story57Process" isExecutable="true">
    <bpmn:startEvent id="S57_Start">
      <bpmn:outgoing>S57_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="S57_f1" sourceRef="S57_Start" targetRef="S57_Kept" />
    <bpmn:serviceTask id="S57_Kept" camunda:expression="${story57Kept}">
      <bpmn:incoming>S57_f1</bpmn:incoming>
      <bpmn:outgoing>S57_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="S57_f2" sourceRef="S57_Kept" targetRef="S57_Gone" />
    <bpmn:serviceTask id="S57_Gone" camunda:delegateExpression="${story57Gone}">
      <bpmn:incoming>S57_f2</bpmn:incoming>
      <bpmn:outgoing>S57_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="S57_f3" sourceRef="S57_Gone" targetRef="S57_Never" />
    <bpmn:serviceTask id="S57_Never" camunda:expression="${story57Never}">
      <bpmn:incoming>S57_f3</bpmn:incoming>
      <bpmn:outgoing>S57_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="S57_f4" sourceRef="S57_Never" targetRef="S57_End" />
    <bpmn:endEvent id="S57_End">
      <bpmn:incoming>S57_f4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
