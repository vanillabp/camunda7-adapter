<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_AggregateChanged" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="AggregateChangedProcess" isExecutable="true">
    <bpmn:startEvent id="AC_Start">
      <bpmn:outgoing>AC_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="AC_f1" sourceRef="AC_Start" targetRef="AC_Wait" />
    <bpmn:intermediateCatchEvent id="AC_Wait">
      <bpmn:incoming>AC_f1</bpmn:incoming>
      <bpmn:outgoing>AC_f2</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${readyToGo}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="AC_f2" sourceRef="AC_Wait" targetRef="AC_Continue" />
    <bpmn:serviceTask id="AC_Continue" camunda:delegateExpression="${conditionMet}">
      <bpmn:incoming>AC_f2</bpmn:incoming>
      <bpmn:outgoing>AC_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="AC_f3" sourceRef="AC_Continue" targetRef="AC_End" />
    <bpmn:endEvent id="AC_End">
      <bpmn:incoming>AC_f3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="AggregateChangedMultiInstanceProcess" isExecutable="true">
    <bpmn:startEvent id="MI_Start">
      <bpmn:outgoing>MI_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="MI_f1" sourceRef="MI_Start" targetRef="MI_Task" />
    <bpmn:serviceTask id="MI_Task" camunda:delegateExpression="${multiInstanceTask}">
      <bpmn:incoming>MI_f1</bpmn:incoming>
      <bpmn:outgoing>MI_f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${items}" camunda:elementVariable="item" />
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="MI_f2" sourceRef="MI_Task" targetRef="MI_End" />
    <bpmn:endEvent id="MI_End">
      <bpmn:incoming>MI_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
