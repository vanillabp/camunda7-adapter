<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_TaskMatrix" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="Error_Payment" name="PaymentFailed" errorCode="PAYMENT_FAILED" />
  <bpmn:process id="TaskProcess" isExecutable="true">
    <bpmn:startEvent id="TP_Start">
      <bpmn:outgoing>TP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="TP_f1" sourceRef="TP_Start" targetRef="TP_Happy" />
    <bpmn:serviceTask id="TP_Happy" camunda:expression="${happyTask}">
      <bpmn:incoming>TP_f1</bpmn:incoming>
      <bpmn:outgoing>TP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="TP_f2" sourceRef="TP_Happy" targetRef="TP_Gateway" />
    <bpmn:exclusiveGateway id="TP_Gateway" default="TP_fNo">
      <bpmn:incoming>TP_f2</bpmn:incoming>
      <bpmn:outgoing>TP_fYes</bpmn:outgoing>
      <bpmn:outgoing>TP_fNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="TP_fYes" sourceRef="TP_Gateway" targetRef="TP_AfterApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="TP_AfterApproval" camunda:expression="${afterApproval}">
      <bpmn:incoming>TP_fYes</bpmn:incoming>
      <bpmn:outgoing>TP_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="TP_f3" sourceRef="TP_AfterApproval" targetRef="TP_End" />
    <bpmn:sequenceFlow id="TP_fNo" sourceRef="TP_Gateway" targetRef="TP_EndRejected" />
    <bpmn:endEvent id="TP_End">
      <bpmn:incoming>TP_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TP_EndRejected">
      <bpmn:incoming>TP_fNo</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="ErrorProcess" isExecutable="true">
    <bpmn:startEvent id="EP_Start">
      <bpmn:outgoing>EP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="EP_f1" sourceRef="EP_Start" targetRef="EP_Task" />
    <bpmn:serviceTask id="EP_Task" camunda:expression="${errorTask}">
      <bpmn:incoming>EP_f1</bpmn:incoming>
      <bpmn:outgoing>EP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="EP_Boundary" attachedToRef="EP_Task">
      <bpmn:outgoing>EP_fErr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EP_ErrDef" errorRef="Error_Payment" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="EP_fErr" sourceRef="EP_Boundary" targetRef="EP_Handle" />
    <bpmn:serviceTask id="EP_Handle" camunda:expression="${errorHandled}">
      <bpmn:incoming>EP_fErr</bpmn:incoming>
      <bpmn:outgoing>EP_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="EP_f2" sourceRef="EP_Task" targetRef="EP_End" />
    <bpmn:sequenceFlow id="EP_f3" sourceRef="EP_Handle" targetRef="EP_EndHandled" />
    <bpmn:endEvent id="EP_End">
      <bpmn:incoming>EP_f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EP_EndHandled">
      <bpmn:incoming>EP_f3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="FailProcess" isExecutable="true">
    <bpmn:startEvent id="FP_Start">
      <bpmn:outgoing>FP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="FP_f1" sourceRef="FP_Start" targetRef="FP_Task" />
    <bpmn:serviceTask id="FP_Task" camunda:expression="${alwaysFails}">
      <bpmn:incoming>FP_f1</bpmn:incoming>
      <bpmn:outgoing>FP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="FP_f2" sourceRef="FP_Task" targetRef="FP_End" />
    <bpmn:endEvent id="FP_End">
      <bpmn:incoming>FP_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="AsyncProcess" isExecutable="true">
    <bpmn:startEvent id="AP_Start">
      <bpmn:outgoing>AP_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="AP_f1" sourceRef="AP_Start" targetRef="AP_Task" />
    <bpmn:serviceTask id="AP_Task" camunda:delegateExpression="${asyncTask}">
      <bpmn:incoming>AP_f1</bpmn:incoming>
      <bpmn:outgoing>AP_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="AP_f2" sourceRef="AP_Task" targetRef="AP_End" />
    <bpmn:endEvent id="AP_End">
      <bpmn:incoming>AP_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="MultiInstanceProcess" isExecutable="true">
    <bpmn:startEvent id="MI_Start">
      <bpmn:outgoing>MI_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="MI_f1" sourceRef="MI_Start" targetRef="MI_Task" />
    <bpmn:serviceTask id="MI_Task" camunda:expression="${miTask}">
      <bpmn:incoming>MI_f1</bpmn:incoming>
      <bpmn:outgoing>MI_f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${items}" camunda:elementVariable="item" />
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="MI_f2" sourceRef="MI_Task" targetRef="MI_End" />
    <bpmn:endEvent id="MI_End">
      <bpmn:incoming>MI_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
