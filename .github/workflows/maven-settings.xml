<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the publish workflow gives Maven when a push to main publishes the snapshots.

  One server, 'vanillabp-central', the server of the profile 'central-portal' in
  io.vanillabp:release-parent. It reads its credentials from environment variables, which only
  the step that publishes sets.

  Nothing is read with a login. spi-for-java and the platform come from Maven Central and its
  snapshot repository, which io.vanillabp:release-parent names and which need no login.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>vanillabp-central</id>
            <username>${env.MAVEN_USERNAME}</username>
            <password>${env.MAVEN_PASSWORD}</password>
        </server>
    </servers>
</settings>
